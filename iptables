#!/usr/bin/env bash
set -e
LOG_FILE="/var/log/pbx_security.log"

# --- 1. Detect OS ---
if command -v yum &> /dev/null; then PKG_MGR="yum";
elif command -v apt-get &> /dev/null; then PKG_MGR="apt";
else echo "Unsupported OS"; exit 1; fi

# --- 2. Install Deps ---
[ "$PKG_MGR" == "yum" ] && yum install -y ipset curl || (apt-get update && apt-get install -y ipset curl)

# --- 3. Setup IPSet ---
ipset create kenya_only hash:net -exist
ipset flush kenya_only
curl -s http://www.ipdeny.com/ipblocks/data/countries/ke.zone | while read -r line; do ipset add kenya_only "$line"; done

# --- 4. Apply Firewall Rules (The WebRTC Update) ---
# Allow Established/Local
iptables -A INPUT -i lo -j ACCEPT
iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# ALLOW Kenyan IPs to:
# 5060 (SIP), 8089 (WebRTC WSS), 3478 (STUN), 10000-65535 (Wide RTP for WebRTC)
iptables -A INPUT -p udp -m multiport --dports 5060,3478,10000:65535 -m set --match-set kenya_only src -j ACCEPT
iptables -A INPUT -p tcp -m multiport --dports 8089 -m set --match-set kenya_only src -j ACCEPT

# DROP all other VOIP traffic from outside Kenya
iptables -A INPUT -p udp -m multiport --dports 5060,3478 -j DROP
iptables -A INPUT -p tcp --dport 8089 -j DROP

# --- 5. Persist ---
if [ "$PKG_MGR" == "yum" ]; then
    ipset save > /etc/sysconfig/ipset
    iptables-save > /etc/sysconfig/iptables
else
    apt-get install -y iptables-persistent
    netfilter-persistent save
fi

echo "WebRTC and SIP Security applied for Kenya."
